import java.util.Scanner;

public class NeedlemanWunsch {

    // Needleman-Wunsch Global Sequence Alignment
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        // Input sequences
        System.out.print("Enter first DNA sequence: ");
        String seq1 = sc.nextLine().toUpperCase();

        System.out.print("Enter second DNA sequence: ");
        String seq2 = sc.nextLine().toUpperCase();

        // Scoring system
        int match = 1;
        int mismatch = -1;
        int gap = -2;

        int m = seq1.length();
        int n = seq2.length();

        // Dynamic Programming matrix
        int[][] dp = new int[m + 1][n + 1];

        // Initialize first row
        for (int j = 0; j <= n; j++) {
            dp[0][j] = j * gap;
        }

        // Initialize first column
        for (int i = 0; i <= m; i++) {
            dp[i][0] = i * gap;
        }

        // Fill DP matrix
        for (int i = 1; i <= m; i++) {

            for (int j = 1; j <= n; j++) {

                int diagonal;

                if (seq1.charAt(i - 1) == seq2.charAt(j - 1)) {
                    diagonal = dp[i - 1][j - 1] + match;
                } else {
                    diagonal = dp[i - 1][j - 1] + mismatch;
                }

                int up = dp[i - 1][j] + gap;
                int left = dp[i][j - 1] + gap;

                dp[i][j] = Math.max(diagonal,
                        Math.max(up, left));
            }
        }

        // Traceback
        StringBuilder alignedSeq1 = new StringBuilder();
        StringBuilder alignedSeq2 = new StringBuilder();

        int i = m;
        int j = n;

        while (i > 0 || j > 0) {

            // Diagonal move
            if (i > 0 && j > 0) {

                int score;

                if (seq1.charAt(i - 1) == seq2.charAt(j - 1)) {
                    score = match;
                } else {
                    score = mismatch;
                }

                if (dp[i][j] == dp[i - 1][j - 1] + score) {

                    alignedSeq1.append(seq1.charAt(i - 1));
                    alignedSeq2.append(seq2.charAt(j - 1));

                    i--;
                    j--;

                    continue;
                }
            }

            // Up move
            if (i > 0 && dp[i][j] == dp[i - 1][j] + gap) {

                alignedSeq1.append(seq1.charAt(i - 1));
                alignedSeq2.append('-');

                i--;

            }

            // Left move
            else if (j > 0 && dp[i][j] == dp[i][j - 1] + gap) {

                alignedSeq1.append('-');
                alignedSeq2.append(seq2.charAt(j - 1));

                j--;
            }
        }

        // Reverse because traceback starts from the end
        alignedSeq1.reverse();
        alignedSeq2.reverse();

        // Display results
        System.out.println("\n========== NEEDLEMAN-WUNSCH ALIGNMENT ==========");

        System.out.println("Sequence 1 : " + seq1);
        System.out.println("Sequence 2 : " + seq2);

        System.out.println("\nOptimal Alignment:");

        System.out.println(alignedSeq1);
        System.out.println(alignedSeq2);

        // Display matching regions
        System.out.print("             ");

        for (int k = 0; k < alignedSeq1.length(); k++) {

            if (alignedSeq1.charAt(k) == alignedSeq2.charAt(k)) {
                System.out.print("|");
            } else {
                System.out.print(" ");
            }
        }

        System.out.println();

        // Final score
        System.out.println("\nAlignment Score: " + dp[m][n]);

        // Display scoring system
        System.out.println("\nScoring System:");
        System.out.println("Match    = " + match);
        System.out.println("Mismatch = " + mismatch);
        System.out.println("Gap      = " + gap);

        sc.close();
    }
}
